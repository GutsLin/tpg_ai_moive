{
  "name": "narrix-backend",
  "version": "1.0.1",
  "description": "Narrix 自部署产品后端服务",
  "main": "dist/app.js",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "worker:dev": "nodemon --exec ts-node src/workers/asset-sync.worker.ts",
    "worker:video:dev": "nodemon --exec ts-node src/workers/video.worker.ts",
    "worker:asset-sync:dev": "nodemon --exec ts-node src/workers/asset-sync.worker.ts",
    "worker:atelier-image:dev": "nodemon --exec ts-node src/workers/atelier-image.worker.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "worker": "node dist/workers/asset-sync.worker.js",
    "worker:video": "node dist/workers/video.worker.js",
    "worker:asset-sync": "node dist/workers/asset-sync.worker.js",
    "worker:atelier-image": "node dist/workers/atelier-image.worker.js",
    "migrate": "ts-node src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@alicloud/credentials": "^2.4.4",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/sts20150401": "^1.2.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.4.0",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.73.0",
    "dotenv": "^17.4.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.0",
    "koa-bodyparser": "^4.4.1",
    "kysely": "^0.28.15",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.2",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "nodemon": "^3.1.14",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
