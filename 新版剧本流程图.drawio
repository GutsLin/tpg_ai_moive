        <mxCell id="ov-title" value="无限流（5分钟 Demo）｜新版剧情总览" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#111827;fontColor=#FFFFFF;fontSize=22;fontStyle=1;arcSize=18;" vertex="1" parent="1"><mxGeometry x="510" y="30" width="620" height="60" as="geometry"/></mxCell>
        <mxCell id="ov-note" value="阅读方式：蓝色＝剧情节点　黄色＝玩家选择　红色＝危险/失败　紫色＝系统信息　绿色＝推进/收束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="105" width="840" height="45" as="geometry"/></mxCell>
