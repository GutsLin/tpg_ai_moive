        <mxCell id="in-change" value="场景瞬间异变&#xa;红纱帐 → 破败白绫&#xa;丝绒大床 → 棺材" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7F1D1D;fontSize=14;fontStyle=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="945" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="in-yuan" value="诡异 Boss“渊”倒吊天花板&#xa;高速刺向苏软软" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7F1D1D;fontSize=14;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="1080" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="in-save" value="完美男友护住苏软软&#xa;金色血液滴落&#xa;“活下去！不要再来找我！”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7F1D1D;fontSize=14;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="1205" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="in-fall" value="苏软软被推落&#xa;完美男友化作金色碎片&#xa;与渊一同被黑暗吞没" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7F1D1D;fontSize=14;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="1345" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="in-awake" value="1-2 现实卧室｜白天&#xa;苏软软惊醒，梦境仍萦绕心头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1E3A5F;fontSize=14;fontStyle=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="1490" width="400" height="80" as="geometry"/></mxCell>
