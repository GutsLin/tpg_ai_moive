  <diagram id="chapter1" name="03-第一章过年">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ch-title" value="第一章节：过年｜荒村分歧流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#111827;fontColor=#FFFFFF;fontSize=22;fontStyle=1;arcSize=18;" vertex="1" parent="1"><mxGeometry x="470" y="30" width="700" height="60" as="geometry"/></mxCell>
        <mxCell id="ch-start" value="1-1 荒村·年家大门前&#xa;8 名玩家抵达" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F5132;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="675" y="145" width="290" height="75" as="geometry"/></mxCell>
        <mxCell id="ch-host" value="年家家主·年晟登场&#xa;“欢迎来到荒村，请许下新年愿望”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1E3A5F;fontSize=14;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="270" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="ch-school" value="校服女许愿：“我想离开这里”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#5F4B00;fontSize=14;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="405" width="400" height="65" as="geometry"/></mxCell>
        <mxCell id="ch-death" value="年晟：“满足你”&#xa;校服女爆裂死亡｜玩家 8 → 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7F1D1D;fontSize=14;fontStyle=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="515" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="ch-rule" value="系统再次提示&#xa;攻略 Boss，好感度 ≥ 80 才能通关" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#4C1D5F;fontSize=14;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="650" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="ch-choice" value="【互动】你的愿望选什么？&#xa;A 与家主共度良宵&#xa;B 放我安全回家&#xa;C 游戏好玩，所有人让我爽" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#5F4B00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="780" width="320" height="190" as="geometry"/></mxCell>
        <mxCell id="ch-a1" value="A：扑到年晟面前&#xa;“我要和你共度良宵！”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#6B3E00;fontSize=14;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="1040" width="310" height="80" as="geometry"/></mxCell>
        <mxCell id="ch-a2" value="年晟愣住｜拍掉她的手&#xa;“不知死活，跟我进来”&#xa;【心动值：5】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F5132;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="1170" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="ch-b1" value="B：“安全回家！”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#6B3E00;fontSize=14;arcSize=12;" vertex="1" parent="1"><mxGeometry x="665" y="1040" width="310" height="70" as="geometry"/></mxCell>
        <mxCell id="ch-b2" value="年晟：“如你所愿”&#xa;黑雾将苏软软扔出大门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7F1D1D;fontSize=14;arcSize=12;" vertex="1" parent="1"><mxGeometry x="665" y="1160" width="310" height="80" as="geometry"/></mxCell>
        <mxCell id="ch-bend" value="【荒村副本完结】" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7F1D1D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="1290" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="ch-c1" value="C：走到轮椅前&#xa;“希望游戏好玩，所有人能让我爽”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#6B3E00;fontSize=14;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="1040" width="330" height="85" as="geometry"/></mxCell>
        <mxCell id="ch-c2" value="指遍众人，最后停在年晟脸前&#xa;“包括你，我的家主大人”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#6B3E00;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="1170" width="330" height="85" as="geometry"/></mxCell>
        <mxCell id="ch-c3" value="苏软软挑衅：下次更刺激&#xa;年晟记下愿望&#xa;【心动值：5】｜奖励：2 条杀戮规则" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F5132;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="1300" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="ch-merge" value="A / C 分支收束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F5132;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="1450" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="ch-steward" value="管家带众人回房&#xa;浮现副本信息与主线任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1E3A5F;fontSize=14;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="1560" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="ch-task" value="【S 级副本：过年】&#xa;辞旧迎新，老祖赐福&#xa;主线：在荒村存活到大年初二" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#4C1D5F;fontSize=14;fontStyle=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="1690" width="420" height="95" as="geometry"/></mxCell>
        <mxCell id="ch-room" value="1-2 荒村·年家客房&#xa;管家警告：夜里无论听见什么，都别开门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1E3A5F;fontSize=14;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="1835" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="ch-noise" value="深夜异响｜拖行声｜窗纸长影&#xa;“外面有东西”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7F1D1D;fontSize=14;arcSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="1970" width="420" height="80" as="geometry"/></mxCell>
